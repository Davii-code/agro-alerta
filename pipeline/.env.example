# Copy to pipeline/.env and fill in. .env is git-ignored.

# Service role key: the pipeline writes risk_scores and market_prices for every
# producer, which RLS would otherwise block.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Where WhatsApp actually goes out. Without these the pipeline prints the
# message instead of sending it, and logs it as a failed attempt.
SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
CRON_SECRET=same-value-as-the-edge-function-secret
